---
layout: layouts/base.njk
---
<article>
  <p class="mb-6">
    <a href="/archive/" class="text-sm text-amber-600 dark:text-amber-500 hover:text-amber-700 dark:hover:text-amber-400">&larr; Back to all stories</a>
  </p>
  <header class="mb-8 border-b border-amber-500/30 pb-6">
    {% if image %}
      <img src="{{ image }}" alt="{{ imageAlt or title }}" class="mb-6 w-full max-h-96 rounded-lg object-cover">
    {% endif %}
    <time datetime="{{ date | isoDate }}" class="text-xs uppercase tracking-wide text-amber-600 dark:text-amber-500">
      {{ date | postDate }}
    </time>
    <h1 class="mt-2 text-3xl sm:text-4xl font-headings font-bold text-gray-900 dark:text-gray-100">{{ title }}</h1>
  </header>
  <div lang="nl" class="prose prose-lg dark:prose-invert max-w-none">
    {{ content | safe }}
  </div>
  {% include "partials/comments.njk" %}
</article>
