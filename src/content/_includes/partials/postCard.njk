<a href="{{ post.url }}" class="block overflow-hidden rounded-lg bg-white hover:bg-gray-50 border border-gray-200 hover:border-amber-500/50 shadow-sm dark:bg-gray-800/60 dark:hover:bg-gray-800 dark:border-gray-700 dark:shadow-none transition{% if featured %} sm:col-span-2{% endif %}">
  {% if post.data.image %}
    <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" class="w-full object-cover {% if featured %}h-56 sm:h-80{% else %}h-40{% endif %}">
  {% endif %}
  <div class="{% if featured %}p-6 sm:p-8{% else %}p-5{% endif %}">
    <time datetime="{{ post.data.date | isoDate }}" class="{% if featured %}text-sm{% else %}text-xs{% endif %} uppercase tracking-wide text-amber-600 dark:text-amber-500">
      {{ post.data.date | postDate }}
    </time>
    <h3 class="mt-2 font-headings font-bold text-gray-900 dark:text-gray-100 {% if featured %}text-2xl sm:text-3xl{% else %}text-lg{% endif %}">{{ post.data.title }}</h3>
    {% if post.data.excerpt %}
      <p class="mt-2 text-gray-600 dark:text-gray-300 {% if featured %}text-base sm:text-lg line-clamp-4{% else %}text-sm line-clamp-3{% endif %}">{{ post.data.excerpt }}</p>
    {% endif %}
  </div>
</a>
