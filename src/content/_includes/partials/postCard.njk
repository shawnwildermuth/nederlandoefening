<a href="{{ post.url }}" class="block overflow-hidden rounded-lg bg-white hover:bg-gray-50 border border-gray-200 hover:border-amber-500/50 shadow-sm dark:bg-gray-800/60 dark:hover:bg-gray-800 dark:border-gray-700 dark:shadow-none transition">
  {% if post.data.image %}
    <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" class="h-40 w-full object-cover">
  {% endif %}
  <div class="p-5">
    <time datetime="{{ post.data.date | isoDate }}" class="text-xs uppercase tracking-wide text-amber-600 dark:text-amber-500">
      {{ post.data.date | postDate }}
    </time>
    <h3 class="mt-2 text-lg font-headings font-bold text-gray-900 dark:text-gray-100">{{ post.data.title }}</h3>
    {% if post.data.excerpt %}
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 line-clamp-3">{{ post.data.excerpt }}</p>
    {% endif %}
  </div>
</a>
